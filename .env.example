# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Режим: paper (бумажная торговля на реальных ценах, ключи не нужны)
#        testnet (тестовая биржа Binance, ключи с testnet.binancefuture.com)
#        live (РЕАЛЬНЫЕ деньги)
MODE=paper

# API-ключи Binance Futures. Права: только "Enable Futures", без вывода средств.
# Обязательно включите ограничение по IP-адресу сервера.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Для MODE=live также нужно явное подтверждение:
# I_UNDERSTAND_THE_RISK=yes

# Риск-менеджмент
# 1% депозита на сделку (для live рекомендуется начать с 0.005)
RISK_PER_TRADE=0.01
# максимум одновременно открытых позиций
MAX_POSITIONS=5
# плечо (изолированная маржа)
LEVERAGE=3
# -3% за день, значит новых сделок до следующего дня нет
DAILY_LOSS_LIMIT=0.03
# -15% от максимума депозита, значит полная остановка
MAX_DRAWDOWN_STOP=0.15

# Выбор пар
# сканировать N самых ликвидных USDT-фьючерсов
TOP_N_SYMBOLS=25
# минимальный оборот за 24 часа, USDT
MIN_QUOTE_VOLUME=50000000

# Бумажная торговля
PAPER_BALANCE=1000
# mainnet | testnet: откуда брать цены для paper
PAPER_DATA=mainnet

# Telegram-уведомления (необязательно): токен от @BotFather, chat_id от @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

POLL_SECONDS=30
